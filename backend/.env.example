# --- Required ---
# Neon: use the POOLED connection string (host contains "-pooler"), e.g.
# postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/staynex
# 32+ random chars (openssl rand -hex 32). The server refuses to boot without it.
JWT_SECRET=replace-with-a-long-random-string
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# Your deployed frontend URL(s), comma-separated. Used for CORS, payment
# redirects and password-reset links. Localhost is always allowed in dev.
FRONTEND_URL=

# Secret for the external job trigger (POST /api/internal/run-jobs with header
# x-cron-secret). Needed on Render's free tier, where the server sleeps and
# in-process cron can't be trusted. 16+ chars. Point cron-job.org (free) at it
# every HOUR (it also wakes Render).
CRON_SECRET=

# --- Messaging (leave blank to log to console instead) ---
SMS_PROVIDER=arkesel
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=StayNex
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=StayNex
BREVO_API_KEY=
EMAIL_FROM=

# --- Other ---
SEMESTER_START_DATE=2026-10-13
ORS_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PORT=4000
NODE_ENV=development
DEBUG_SQL=false

# --- Admin (read only by npm run seed-admin) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
